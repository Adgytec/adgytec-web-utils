{
    "name": "@adgytec/adgytec-web-utils",
    "private": false,
    "version": "0.2.0",
    "type": "module",
    "sideEffects": false,
    "files": [
        "dist"
    ],
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "types": "./dist/index.d.ts"
        }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "generate:index": "node src/scripts/generate-root-index.mjs",
        "lint": "biome check .",
        "lint:fix": "biome check --write .",
        "format": "biome format --write .",
        "dev": "vite",
        "typecheck": "tsc -b",
        "build": "npm run generate:index && npm run lint && npm run typecheck && vite build",
        "preview": "vite preview",
        "release": "npm run build && npm publish --public",
        "test": "node --import tsx --test tests/**/*.test.ts"
    },
    "peerDependencies": {
        "@datastructures-js/queue": ">=4.3.0",
        "is-network-error": ">=1.3.1",
        "uuid": ">=13.0.0",
        "zod": ">=4.3.6"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.4.8",
        "@datastructures-js/queue": "^4.3.0",
        "@types/node": "^25.3.3",
        "glob": "^13.0.6",
        "sonda": "^0.11.1",
        "tsx": "^4.21.0",
        "typescript": "~5.9.3",
        "uuid": "^13.0.0",
        "vite": "^7.3.1",
        "vite-plugin-dts": "^4.5.4",
        "zod": "^4.3.6"
    },
    "author": {
        "name": "Adgytec",
        "email": "rohan@adgytec.in",
        "url": "https://adgytec.in"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/Adgytec/adgytec-web-utils.git"
    },
    "homepage": "https://github.com/Adgytec/adgytec-web-utils/#/README.md"
}
