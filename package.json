{
    "name": "@adgytec/adgytec-web-utils",
    "private": false,
    "version": "0.3.0",
    "type": "module",
    "sideEffects": false,
    "files": [
        "dist"
    ],
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "types": "./dist/index.d.ts"
        }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "generate:index": "node src/scripts/generate-root-index.mjs",
        "lint": "biome check .",
        "lint:fix": "biome check --write .",
        "format": "biome format --write .",
        "dev": "vite",
        "typecheck": "tsc -b",
        "build": "npm run generate:index && npm run lint && npm run typecheck && vite build",
        "preview": "vite preview",
        "release": "npm run build && npm publish --public",
        "test": "node --import tsx --test tests/**/*.test.ts"
    },
    "peerDependencies": {
        "http-constants-ts": ">=1.0.8",
        "is-network-error": ">=1.3.1",
        "zod": ">=4.3.6"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.15",
        "@types/node": "^26.6.3",
        "@typescript/typescript6": "^6.0.2",
        "glob": "^13.0.6",
        "http-constants-ts": "^1.0.8",
        "sonda": "^0.14.0",
        "tsx": "^4.23.15",
        "typescript": "~7.0.2",
        "unplugin-dts": "^1.1.1",
        "vite": "^8.3.1",
        "vite-plugin-dts": "^5.1.1",
        "zod": "^4.6.5"
    },
    "author": {
        "name": "Adgytec",
        "email": "rohan@adgytec.in",
        "url": "https://adgytec.in"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/Adgytec/adgytec-web-utils.git"
    },
    "homepage": "https://github.com/Adgytec/adgytec-web-utils/#/README.md",
    "allowScripts": {
        "esbuild@0.28.2": true
    }
}
